# Server-only: copy the exact PostgreSQL host/user/port from Supabase > Connect.
# This is a PLACEHOLDER, not a working credential. Percent-encode password characters.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional: Supabase database CA certificate PEM, downloaded from Database settings.
# Required when the endpoint certificate is not trusted by Node's system roots.
DATABASE_CA_CERT_PATH=
# Generate a long random secret locally; never use this placeholder in production.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=3000
