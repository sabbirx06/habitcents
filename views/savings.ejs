<%- include('partials/head',{title:'Savings · HabitCents',css:['/css/base.css','/css/workspaces.css']}) %>
<body><%- include('partials/navbar') %><main class="workspace-page" data-page="savings"><% if(typeof demo!=='undefined'&&demo){ %><p class="workspace-muted">Demo preview · Sample data · Changes stay in memory</p><% } %>
<%- include('partials/page-header', {heading: 'Your goals.', right: '<button id="goal-new" class="page-header-action" type="button">+ New Goal</button>'}) %>
<div class="savings-controls"><div id="goals-filter" class="segmented-control" role="group" aria-label="Show goals"><button type="button" data-value="active" aria-pressed="true">Active</button><button type="button" data-value="completed" aria-pressed="false">Completed</button><button type="button" data-value="archived" aria-pressed="false">Archived</button></div><div id="goals-view" class="segmented-control" role="group" aria-label="Goal visualization"><button type="button" data-value="circular" aria-pressed="true">Circular</button><button type="button" data-value="linear" aria-pressed="false">Linear</button></div></div><div class="goals-overview"><p id="savings-count" class="workspace-muted"></p><p class="workspace-muted">Saved across active goals: <span id="savings-total">—</span></p></div><p class="workspace-muted">Completed goals stay active until archived.</p><p id="savings-status" class="workspace-status" role="status">Loading goals…</p><button id="savings-retry" class="workspace-button secondary" type="button" hidden>Retry</button><section id="goals-list" class="workspace-grid" aria-label="Savings goals"></section>
</main><script type="module">import {initSavings} from '/js/savings.js';initSavings();</script></body></html>