<%- include('partials/head',{title:'Savings · HabitCents',css:['/css/base.css','/css/workspaces.css']}) %>
<body><%- include('partials/navbar') %><main class="workspace-page" data-page="savings"><% if(typeof demo!=='undefined'&&demo){ %><p class="workspace-muted">Demo preview · Sample data · Changes stay in memory</p><% } %>
<%- include('partials/page-header', {heading: 'Your goals.', right: '<button id="goal-new" class="page-header-action header-primary-action" type="button"><span aria-hidden="true">+</span> New Goal</button>'}) %>
<div class="savings-controls"><div id="goals-filter" class="segmented-control" role="group" aria-label="Show goals"><button type="button" data-value="active" aria-pressed="true">Active</button><button type="button" data-value="completed" aria-pressed="false">Completed</button><button type="button" data-value="archived" aria-pressed="false">Archived</button></div><section class="workspace-card savings-total-card" aria-label="Total saved"><span class="workspace-muted">Total saved</span><strong id="savings-total">—</strong></section></div><p id="savings-status" class="workspace-status" role="status">Loading goals…</p><button id="savings-retry" class="workspace-button secondary" type="button" hidden>Retry</button><section id="goals-list" class="savings-list" aria-label="Savings goals"></section>
</main><script type="module">import {initSavings} from '/js/savings.js';initSavings();</script></body></html>
