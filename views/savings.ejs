<%- include('partials/head',{title:'Savings · HabitCents',css:['/css/base.css','/css/workspaces.css']}) %>
<body><%- include('partials/navbar') %><main class="workspace-page" data-page="savings"><% if(typeof demo!=='undefined'&&demo){ %><p class="workspace-muted">Demo preview · Sample data · Changes stay in memory</p><% } %>
<header class="workspace-header"><div><h1>Your goals.</h1><p>Make room for what matters next.</p></div><button id="goal-new" class="workspace-button" type="button">+ New Goal</button></header>
<div class="goals-overview"><p id="savings-count" class="workspace-muted"></p><button id="goal-options" class="workspace-icon-button" type="button" aria-label="Filter and manage goals" title="Filter goals"><%- include('partials/workspace-icon',{name:'filters'}) %></button></div><div id="goal-controls" class="workspace-toolbar" hidden><label><span class="workspace-label">Show</span><select id="goals-filter"><option value="active">Active goals</option><option value="completed">Completed goals</option><option value="archived">Archived goals</option></select></label><div><p class="workspace-muted">Saved across active goals</p><p id="savings-total" class="goal-amount">—</p><p class="workspace-muted">Completed goals stay active until archived.</p></div></div><p id="savings-status" class="workspace-status" role="status">Loading goals…</p><button id="savings-retry" class="workspace-button secondary" type="button" hidden>Retry</button><section id="goals-list" class="workspace-grid" aria-label="Savings goals"></section>
</main><script type="module">import {initSavings} from '/js/savings.js';initSavings();</script></body></html>