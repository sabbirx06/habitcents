<%- include('partials/head',{title:'Expenses · HabitCents',css:['/css/base.css','/css/workspaces.css']}) %>
<body><%- include('partials/navbar') %><main class="workspace-page" data-page="expenses"><% if(typeof demo!=='undefined'&&demo){ %><p class="workspace-muted">Demo preview · Sample data · Changes stay in memory</p><% } %>
<%- include('partials/page-header', {heading: 'Your money.', right: include('partials/header-expense-month')}) %>
<p id="expenses-status" class="workspace-status" role="status">Loading expenses…</p><button id="expenses-retry" class="workspace-button secondary" type="button" hidden>Retry</button>
<div class="expense-workspace"><section class="workspace-card blue expense-budget"><div class="workspace-topline"><h2>Remaining budget</h2><button id="budget-edit" class="workspace-text-button" type="button">Edit budget ↗</button></div><p id="monthly-budget" class="workspace-number">—</p><div class="workspace-meter" id="expense-budget-meter" role="progressbar" aria-label="Budget remaining" aria-valuemin="0" aria-valuemax="100"><span></span></div><div class="budget-caption"><span><span id="expense-budget-total">—</span> budget</span><span id="budget-warning" class="workspace-muted"></span></div></section><section class="workspace-card expense-spent"><h2>Spent</h2><p id="expense-budget-spent" class="workspace-number">—</p><p class="workspace-muted">this month</p></section>
<section class="workspace-card expense-recurring"><div class="workspace-topline"><h2>Recurring expenses</h2><button id="recurring-new" class="workspace-button secondary small" type="button" aria-label="New recurring expense">+ New</button></div><p class="workspace-muted">Upcoming payments need confirmation before becoming transactions.</p><p id="recurring-status" class="workspace-status" role="status"></p><button id="recurring-retry" class="workspace-button secondary small" type="button" hidden>Retry</button><div id="recurring-list"></div></section>
<section class="workspace-card expense-trend"><div class="workspace-topline"><div class="chart-heading"><h2>Spending over time</h2><span class="chart-help"><button id="spending-help-button" type="button" aria-label="How to inspect spending" aria-describedby="spending-help-text"><span aria-hidden="true">i</span></button><span id="spending-help-text" role="tooltip" hidden>Focus or tap a bar to inspect its value. Use the left and right arrow keys to move between dates.</span></span></div><details><summary>Daily values</summary><div id="daily-values"></div></details></div><p id="expense-period" class="workspace-muted"></p><div class="workspace-chart"><div id="expense-y-axis" class="workspace-y" aria-hidden="true"></div><div id="expense-bars" class="workspace-bars" role="group" aria-label="Daily recorded spending; use arrow keys"></div></div><div id="expense-x-axis" class="workspace-x" aria-hidden="true"></div><output id="expense-chart-detail" class="chart-inspection"></output></section>
<section class="workspace-card expense-breakdown"><div class="workspace-topline"><h2>By category</h2><button id="category-options" class="workspace-icon-button" aria-label="Category chart options" title="Chart options" type="button"><%- include('partials/workspace-icon',{name:'more'}) %></button><div id="category-controls" hidden><div class="chart-switch" role="group" aria-label="Category chart style"><button type="button" id="breakdown-circle" aria-pressed="true">Circle</button><button type="button" id="breakdown-bar" aria-pressed="false">Bar</button></div></div></div><div class="category-layout"><div id="category-visual"></div><ul id="category-legend" class="category-legend" aria-label="Category spending amounts"></ul></div></section>
<section class="workspace-card expense-transactions"><div class="workspace-topline"><h2>Transactions</h2><div class="recurring-actions"><span id="transaction-count" class="workspace-muted"></span><button id="transaction-options" class="workspace-icon-button" type="button" aria-label="Search and filter transactions" title="Search and filter"><%- include('partials/workspace-icon',{name:'filters'}) %></button></div></div><div id="transaction-controls" class="workspace-toolbar" hidden><label><span class="workspace-label">Search</span><input id="transaction-search" type="search" placeholder="Search descriptions"></label><label><span class="workspace-label">Category</span><select id="transaction-category"><option value="all">All categories</option><option value="transport">Transport</option><option value="food">Food</option><option value="subscriptions">Subscriptions</option><option value="shopping">Shopping</option><option value="uncategorized">Uncategorized</option></select></label><label><span class="workspace-label">From</span><input id="transaction-from" type="date"></label><label><span class="workspace-label">Through</span><input id="transaction-through" type="date"></label><label><span class="workspace-label">Sort</span><select id="transaction-sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="largest">Largest amount</option><option value="smallest">Smallest amount</option></select></label></div><ul id="expense-list" class="transactions"></ul></section>
</div><div id="calendar-panel" hidden><p class="workspace-muted">Amounts are recorded expenses, not a complete account of all spending.</p><div id="spending-calendar" class="spending-calendar"></div></div>
<%- include('partials/floating-action',{id:'expense-new',label:'Add Expense'}) %></main><script type="module">import {initExpenses} from '/js/expenses.js';initExpenses();</script></body></html>