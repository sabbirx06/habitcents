<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#dedbd4" />
    <title>Login - HabitCents</title>
    <script src="/js/motion-preference.js"></script>
    <link rel="stylesheet" href="/css/motion-preference.css" />
    <link rel="stylesheet" href="/css/fonts.css" />
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="icon" href="/media/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="auth-page">
    <main class="auth-layout">
      <aside class="auth-art" aria-label="HabitCents">
        <a class="auth-brand" href="/" aria-label="HabitCents home">HabitCents<span aria-hidden="true">®</span></a>
        <div class="art-guides" aria-hidden="true"></div>
        <svg class="auth-symbol" viewBox="0 0 160 160" fill="none" aria-hidden="true">
          <path d="M80 2V63M80 97V158M2 80H63M97 80H158M39 39L68 68M92 92L121 121M39 121L68 92M92 68L121 39" stroke="currentColor" stroke-width="5"/>
        </svg>
        <small class="auth-copyright">© HabitCents. All rights reserved.</small>
      </aside>
      <section class="auth-content" aria-labelledby="auth-title">
        <a class="auth-alternate" href="/signup">Create an account</a>
        <div class="auth-form-wrap">
          <h1 id="auth-title">Login</h1>
          <% if (typeof query !== 'undefined' && query.error) { %>
            <div class="auth-alert auth-alert-error" role="alert"><%= query.error %></div>
          <% } %>
          <% if (typeof query !== 'undefined' && query.success) { %>
            <div class="auth-alert auth-alert-success" role="status"><%= query.success %></div>
          <% } %>
          <form id="auth-form" action="/login" method="POST" class="auth-form">
            
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="password">Password</label>
              <div class="password-input">
                <input type="password" id="password" name="password" placeholder="Your password" autocomplete="current-password" required />
                <button class="password-toggle" type="button" aria-label="Show password" aria-controls="password" aria-pressed="false">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                </button>
              </div>
            </div>
            <button type="submit" class="auth-submit">Log in</button>
          </form>
        </div>
      </section>
    </main>
    <script src="/js/auth.js" defer></script>
  </body>
</html>
