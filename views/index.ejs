<!doctype html>
<html lang="en">
  <head>
    <script src="/js/motion-preference.js"></script>
    <link rel="stylesheet" href="/css/motion-preference.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Habitcents</title>

    <link rel="stylesheet" href="/css/fonts.css" />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" href="/media/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <!-- Navbar: simple site navigation for visitors -->
    <div class="container-fluid navbar-container">
      <nav class="navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand" href="/habits">Habitcents</a>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item nav-signup d-flex gap-2">
            <button
              type="button"
              class="btn btn-primary"
              onclick="window.location.href = '/signup'"
            >
              Sign Up
            </button>
            <button
              type="button"
              class="btn btn-outline-light"
              onclick="window.location.href = '/login'"
            >
              Login
            </button>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Hero Section -->
    <div class="container-fluid hero-bg">
      <div class="hero-text align-items-center text-center">
        <img src="/media/logo.png" alt="Habitcents logo" class="logo-dash" />
        <h1 class="main-heading">Habitcents</h1>
        <p class="text-dash">
          Welcome to Habitcents! <br />
          Your personal habit and expense tracker
        </p>
        <button
          type="button"
          class="btn btn-primary btn-lg btn-get-started mt-4"
          onclick="window.location.href = '/signup'"
        >
          Get Started
        </button>
        <!-- <div class="d-flex gap-3 justify-content-center mt-4">
          <a href="/habits" class="btn btn-outline-light btn-lg">
            Go to Habits
          </a>
          <a href="/expenses" class="btn btn-primary btn-lg">
            Go to Expenses
          </a>
        </div> -->
      </div>
    </div>

    <%- include("partials/footer") %>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
