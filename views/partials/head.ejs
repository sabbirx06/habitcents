<!-- EJS Head Partial - Reusable HTML head section for all pages -->
<!-- This partial eliminates code duplication by providing consistent head structure -->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Dynamic page title - defaults to "Habitcents" if not specified -->
    <title><%= title || 'Habitcents' %></title>

    <link rel="preload" href="/fonts/NeueHaasGrotText-55Roman-Trial.otf" as="font" type="font/otf" crossorigin />
    <link rel="stylesheet" href="/css/fonts-authenticated.css" />
    <script src="/js/navigation.js" defer></script>

    <!-- Bootstrap CSS framework for responsive design -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Dynamic CSS loading - pages can specify their own stylesheets -->
    <% if (typeof css !== 'undefined' && css) { %>
      <% css.forEach(href => { %>
        <link rel="stylesheet" href="<%= href %>" />
      <% }); %>
    <% } %>

    <!-- Favicon for browser tab -->
    <link rel="icon" href="/media/favicon.svg" type="image/svg+xml" />
  </head>