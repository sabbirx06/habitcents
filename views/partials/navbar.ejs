<!-- Shared floating navigation for authenticated pages -->
<nav class="nav-dock" aria-label="Primary navigation">
 <a class="dock-link dock-brand" href="/dashboard" aria-label="HabitCents home"><%- include('brand', {variant: 'mark'}) %><span class="dock-tooltip" aria-hidden="true">HabitCents home</span></a>
 <span class="dock-separator" aria-hidden="true"></span>
 <ul class="dock-links">
 <% const destinations = [
  ['dashboard','Overview','<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>'],
  ['habits','Habits','<rect x="4" y="4" width="16" height="17" rx="3"/><path d="M9 3v3m6-3v3M8 12l3 3 5-5"/>'],
  ['expenses','Expenses','<path d="M4 6h14a2 2 0 0 1 2 2v11H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12v2"/><path d="M20 10h-5a2 2 0 0 0 0 4h5m-4-2h.01"/>'],
  ['savings','Savings','<path d="M7 8a7 7 0 0 1 9 0l4-1v5l2 1v4h-3l-1 4h-3v-3H9v3H6l-1-5a6 6 0 0 1-2-5L1 9m8-4h5m3 7h.01"/>'],
  ['profile','Profile','<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>']
 ]; %>
 <% for (const [destination,label,paths] of destinations) { %>
  <li><a class="dock-link <%= page === destination ? 'active' : '' %>" <%- page === destination ? 'aria-current="page"' : '' %> href="/<%= destination %>" aria-label="<%= label %>"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%- paths %></svg><span class="dock-tooltip" aria-hidden="true"><%= label %></span></a></li>
 <% } %>
 </ul>
</nav>
<% if (typeof demo !== 'undefined' && demo && !['dashboard','habits','expenses','savings'].includes(page)) { %>
 <p class="preview-banner">Demo preview · sample data only. Account forms are unavailable in this preview.</p>
<% } %>
