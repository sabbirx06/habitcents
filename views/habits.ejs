<%- include('partials/head',{title:'Habits · HabitCents',css:['/css/base.css','/css/workspaces.css']}) %>
<body><%- include('partials/navbar') %><main class="workspace-page" data-page="habits"><% if(typeof demo!=='undefined'&&demo){ %><p class="workspace-muted">Demo preview · Sample data · Changes stay in memory</p><% } %>
<%- include('partials/page-header', {heading: 'Your habits.', right: '<button id="habit-new" class="page-header-action habit-new-action" type="button"><span aria-hidden="true">+</span> Add new habit</button>'}) %>
<div class="habit-summaries"><section class="workspace-card lavender habit-progress-card" aria-labelledby="habit-progress-heading"><h2 id="habit-progress-heading">Today's progress</h2><p id="habit-summary" class="workspace-number">—</p><p id="habit-summary-context" class="workspace-muted"></p><div class="workspace-meter" role="progressbar" aria-label="Today's habit completion" aria-valuemin="0" aria-valuemax="100" id="habit-summary-meter"><span></span></div></section><section class="workspace-card lime habit-streak-card" aria-labelledby="habit-streak-heading"><h2 id="habit-streak-heading">Universal streak</h2><p class="workspace-number"><span id="habit-streak">—</span> <small>days</small></p><p id="habit-streak-context" class="workspace-muted"></p><button id="streak-start" class="workspace-button secondary small" type="button" hidden>Start tracking today</button></section></div>
<p id="habits-status" class="workspace-status" role="status">Loading habits…</p><button id="habits-retry" class="workspace-button secondary" type="button" hidden>Retry</button><section id="habit-list" class="workspace-grid" aria-label="Your habit cards"></section>
</main><script type="module">import {initHabits} from '/js/habits.js';initHabits();</script></body></html>
