<%- include('partials/head',{title:'Habits · HabitCents',css:['/css/base.css','/css/workspaces.css']}) %>
<body><%- include('partials/navbar') %><main class="workspace-page" data-page="habits"><% if(typeof demo!=='undefined'&&demo){ %><p class="workspace-muted">Demo preview · Sample data · Changes stay in memory</p><% } %>
<header class="workspace-header"><div><h1>Your habits.</h1><p>A little progress, every day.</p></div><div class="recurring-actions"><button id="habit-options" class="workspace-icon-button" type="button" aria-label="Filter and manage habits" title="Filter and manage habits"><%- include('partials/workspace-icon',{name:'filters'}) %></button><button id="habit-new" class="workspace-button" type="button" aria-label="New habit"><span aria-hidden="true">+</span><span class="habit-new-label">New Habit</span></button></div></header>
<section class="habit-summary-card workspace-card lavender" aria-label="Habit summaries"><div><h2>Today's progress</h2><p id="habit-summary" class="workspace-number">—</p><p id="habit-summary-context" class="workspace-muted"></p></div><div class="habit-summary-streak"><h2>Your streak</h2><p class="workspace-number"><span id="habit-streak">—</span> <small>days</small></p><p id="habit-streak-context" class="workspace-sr-only"></p><button id="streak-start" class="workspace-button secondary small" type="button" hidden>Start tracking today</button></div><div class="workspace-meter" role="progressbar" aria-label="Today's habit completion" aria-valuemin="0" aria-valuemax="100" id="habit-summary-meter"><span></span></div></section>
<div id="habit-controls" class="workspace-toolbar" hidden><label><span class="workspace-label">Show</span><select id="habit-filter"><option value="all">All current habits</option><option value="due">Due today</option><option value="archived">Archived habits</option></select></label><label><span class="workspace-label">Category</span><select id="habit-category"><option value="all">All categories</option></select></label><button id="habit-presets" class="workspace-button secondary" type="button" aria-label="Explore habit presets" title="Explore presets"><%- include('partials/workspace-icon',{name:'library'}) %> Explore presets</button><button id="habit-categories" class="workspace-button secondary" type="button">Manage categories</button></div>
<p id="habits-status" class="workspace-status" role="status">Loading habits…</p><button id="habits-retry" class="workspace-button secondary" type="button" hidden>Retry</button><section id="habit-list" class="workspace-grid" aria-label="Your habit cards"></section>
</main><script type="module">import {initHabits} from '/js/habits.js';initHabits();</script></body></html>
