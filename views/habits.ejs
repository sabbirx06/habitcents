<%- include('partials/head',{title:'Habits · HabitCents',css:['/css/base.css','/css/workspaces.css']}) %>
<body><%- include('partials/navbar') %><main class="workspace-page" data-page="habits"><% if(typeof demo!=='undefined'&&demo){ %><p class="workspace-muted">Demo preview · Sample data · Changes stay in memory</p><% } %>
<%- include('partials/page-header', {heading: 'Your habits.', right: '<button id="habit-new" class="page-header-action habit-new-action" type="button"><span aria-hidden="true">+</span> Add new habit</button>'}) %>
<div class="habit-summaries"><section class="workspace-card lavender habit-progress-card" aria-labelledby="habit-progress-heading"><div class="habit-card-topline"><h2 id="habit-progress-heading">Today's progress</h2><span class="panel-symbol" aria-hidden="true">✳</span></div><p class="completion-number"><span id="habit-summary">—</span></p><div class="workspace-meter" role="progressbar" aria-label="Today's habit completion" aria-valuemin="0" aria-valuemax="100" id="habit-summary-meter"><span></span></div><p id="habit-summary-context" class="muted-copy"></p></section><section class="workspace-card lime habit-streak-card" aria-labelledby="habit-streak-heading"><div class="habit-card-topline"><h2 id="habit-streak-heading">Universal streak</h2><span class="chart-help"><button id="habit-streak-info-button" type="button" aria-label="About the universal streak" aria-describedby="habit-streak-info-text"><span aria-hidden="true">i</span></button><span id="habit-streak-info-text" role="tooltip" hidden>Complete every habit scheduled today to earn one day.</span></span></div><p class="habit-streak-figure"><span id="habit-streak">—</span><span>days</span></p><p id="habit-streak-context" class="workspace-muted"></p><button id="streak-start" class="workspace-button secondary small" type="button" hidden>Start tracking today</button></section><section class="workspace-card lavender habit-completion-card" aria-labelledby="habit-completion-heading"><h2 id="habit-completion-heading">Habit completion percentage</h2><p id="habit-completion-rate" class="completion-percentage" data-state="unavailable">—</p></section></div>
<p id="habits-status" class="workspace-status" role="status">Loading habits…</p><button id="habits-retry" class="workspace-button secondary" type="button" hidden>Retry</button><section id="habit-list" class="workspace-grid" aria-label="Your habit cards"></section>
</main><script type="module">import {initHabits} from '/js/habits.js';initHabits();</script></body></html>
